{
  "name": "yalla-lebanon-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:delivery": "vitest run test/delivery.test.ts",
    "test:pricing": "vitest run test/pricing.test.ts",
    "test:catalog": "vitest run test/catalogIntegrity.test.ts",
    "test:security": "vitest run test/security.test.ts",
    "test:rules": "npx firebase emulators:exec --only firestore \"vitest run test/rules.test.ts\"",
    "verify": "npm run lint && npm run test:delivery && npm run test:pricing && npm run test:catalog && npm run test:security && npm run test:rules",
    "grant-admin": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "papaparse": "^5.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^13.29.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tar": "^7.5.3",
    "qs": "^6.16.0",
    "stream-json": "^1.9.1",
    "uuid": "^11.1.1"
  }
}
