# ==============================================================================
# Yalla Lebanon - Environment Configuration
# ==============================================================================
# WARNING: This application is a client-side Single Page Application (SPA).
# Any variable with the VITE_ prefix is bundled into public client-side JavaScript
# and is visible to all website visitors. NEVER place server secret keys, private
# service account credentials, or database passwords in this file.
# ==============================================================================

# Public Application Base URL
APP_URL=https://yalla.lb

# Firebase App Check / reCAPTCHA Enterprise Site Key (Public Client Key)
VITE_RECAPTCHA_SITE_KEY=

# Server-Side OTP Delivery Provider Configuration (Cloud Functions Environment Variables)
# Required for production OTP dispatch via email/SMS.
RESEND_API_KEY=
SENDGRID_API_KEY=
SENDER_EMAIL=security@yalla.lb
