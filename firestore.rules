rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.admin == true ||
          request.auth.token.email == 'jamilarabi2000@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Health / probe ping document used by connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catalog & Content (Products, Bundles, Categories, Sellers, Discounts, CMS, Settings)
    // Public read for all visitors; write allowed for store management
    match /products/{productId} {
      allow read, write: if true;
    }

    match /product_bundles/{bundleId} {
      allow read, write: if true;
    }

    match /categories/{catId} {
      allow read, write: if true;
    }

    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    match /discounts/{discountId} {
      allow read, write: if true;
    }

    match /cms/{docId} {
      allow read, write: if true;
    }

    match /site_settings/{docId} {
      allow read, write: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // User Accounts & Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Phone registry index for registration/lookup
    match /phone_registry/{phoneKey} {
      allow read, write: if true;
    }

    // Carts & Wishlists (Supports both guest & logged in user state sync)
    match /carts/{userId} {
      allow read, write: if true;
    }

    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Orders (Allows placement by guests/users, lookup by tracking number/orderId, & management)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Product Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Admin Activity & Config
    match /recent_activity/{activityId} {
      allow read, write: if true;
    }

    match /admin_config/{docId} {
      allow read, write: if true;
    }

    // Search analytics logs
    match /search_logs/{logId} {
      allow read, write: if true;
    }
  }
}
