rules_version = '2';

// =============================================================================
// Yalla Lebanon - Cloud Firestore Security Rules
//
// THREAT MODEL
// This application has no trusted backend: the React client talks straight to
// Firestore with the (public) Web API key. Every check written in TypeScript is
// therefore a user-experience affordance, not a control - an attacker calls the
// Firestore REST/gRPC API with their own ID token and never runs your code.
//
// THIS FILE IS THE ONLY SECURITY BOUNDARY. Assume every field of every write is
// attacker-chosen.
//
// Every hasOnly() list below is pinned to what the application actually writes.
// If you add a field to a payload, add it here too or the write will be denied.
// `npm run test:rules` covers both directions: attacks must fail, and the real
// client payloads must succeed.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerified() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    // Admin authorization:
    // 1. Firebase custom admin claim
    // 2. Explicit verified platform-admin email
    // 3. Admin registry document
    function isAdmin() {
      return isSignedIn() && (
        (
          'admin' in request.auth.token
          && request.auth.token.admin == true
        )
        ||
        (
          'email' in request.auth.token
          && request.auth.token.email == 'jamilarabi2000@gmail.com'
          && 'email_verified' in request.auth.token
          && request.auth.token.email_verified == true
        )
        ||
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
      );
    }

    function isSeller() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('role', '') == 'seller';
    }

    function getSellerId() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.get('sellerId', '');
    }

    // ---------------------------------------------------------------------
    // Value guards
    // ---------------------------------------------------------------------

    function isMoney(v, maxValue) {
      return v is number && v >= 0 && v <= maxValue;
    }

    function boundedString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------------------------------------------------------------------
    // Health / probe ping document used by connection testing
    // ---------------------------------------------------------------------

    match /test/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Catalogue
    // ---------------------------------------------------------------------

    function productShapeOk() {
      return request.resource.data.priceUSD is number
        && request.resource.data.priceUSD >= 0
        && request.resource.data.priceUSD <= 1000000
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 1000000
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 250;
    }

    function sellerProductPayloadOk() {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'arabicName', 'artisan', 'seller', 'arabicSeller',
        'sellerId', 'origin', 'category', 'priceUSD',
        'originalPriceUSD', 'image', 'additionalImages', 'videoUrl',
        'additionalVideos', 'videos', 'description', 'craftStory', 'stock',
        'isPublished', 'tags', 'keywords', 'arabicKeywords', 'seoTitle',
        'seoArabicTitle', 'seoDescription', 'seoArabicDescription',
        'weightOrVolume', 'sellerItemCode', 'lowStockThreshold',
        'lowStockNotice', 'customStockLabel', 'createdAt', 'updatedAt'
      ])
      && !request.resource.data.keys().hasAny([
        'sellerActive',
        'rating',
        'reviewCount',
        'ordersCount',
        'soldCount',
        'featured',
        'isPromoted'
      ]);
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          isSeller()
          && request.resource.data.get('id', '') == productId
          && request.resource.data.get('sellerId', '') == getSellerId()
          && sellerProductPayloadOk()
          && productShapeOk()
        );

      allow update: if isAdmin()
        || (
          isSeller()
          && resource.data.get('sellerId', '') == getSellerId()
          && request.resource.data.get('sellerId', '') == getSellerId()
          && request.resource.data.get('id', productId) == productId
          && sellerProductPayloadOk()
          && productShapeOk()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'id',
            'sellerId',
            'sellerActive',
            'rating',
            'reviewCount',
            'ordersCount',
            'soldCount',
            'featured',
            'isPromoted'
          ])
        );

      allow delete: if isAdmin()
        || (
          isSeller()
          && resource.data.get('sellerId', '') == getSellerId()
        );
    }

    match /product_bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Seller company profile
    // ---------------------------------------------------------------------

    function noPrivateSellerFields() {
      return !request.resource.data.keys().hasAny([
        'accountEmail',
        'accountUid',
        'commissionPct',
        'exactAddress'
      ]);
    }

    function sellerSelfEditableKeys() {
      return [
        'id',
        'sellerCode',
        'nameEn',
        'nameAr',
        'bio',
        'bioEn',
        'bioAr',
        'village',
        'district',
        'governorate',
        'region',
        'phone',
        'contactPhone',
        'whatsapp',
        'contactEmail',
        'logoUrl',
        'bannerImage',
        'profileImage',
        'craftCategory',
        'updatedAt'
      ];
    }

    match /sellers/{sellerId} {
      allow read: if true;

      allow create: if isAdmin()
        && noPrivateSellerFields();

      allow update: if (
          isAdmin()
          && noPrivateSellerFields()
        )
        || (
          isSeller()
          && sellerId == getSellerId()
          && request.resource.data.get('id', sellerId) == getSellerId()
          && noPrivateSellerFields()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(sellerSelfEditableKeys())
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Restricted seller record
    // ---------------------------------------------------------------------

    match /seller_private/{sellerId} {
      allow read: if isAdmin()
        || (
          isSeller()
          && sellerId == getSellerId()
        );

      allow create: if isAdmin()
        || (
          isSeller()
          && sellerId == getSellerId()
          && request.resource.data.keys().hasOnly([
            'exactAddress',
            'updatedAt'
          ])
        );

      allow update: if isAdmin()
        || (
          isSeller()
          && sellerId == getSellerId()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'exactAddress',
                 'updatedAt'
               ])
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Seller applications
    // ---------------------------------------------------------------------

    match /seller_applications/{appId} {
      allow read, update, delete: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly([
          'id',
          'sellerCompany',
          'workshopName',
          'workshopNameAr',
          'nameEn',
          'nameAr',
          'firstName',
          'middleName',
          'lastName',
          'contactName',
          'email',
          'phone',
          'village',
          'governorate',
          'craftType',
          'craftCategory',
          'story',
          'bio',
          'socialLink',
          'status',
          'createdAt',
          'submittedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.get('id', appId) == appId
        && boundedString(request.resource.data.get('id', appId), 100)
        && boundedString(request.resource.data.sellerCompany, 200)
        && request.resource.data.sellerCompany.size() > 0
        && boundedString(request.resource.data.email, 200)
        && request.resource.data.email.size() > 0
        && boundedString(request.resource.data.phone, 60)
        && request.resource.data.phone.size() > 0
        && boundedString(
          request.resource.data.get('workshopName', ''),
          200
        )
        && boundedString(
          request.resource.data.get('workshopNameAr', ''),
          200
        )
        && boundedString(
          request.resource.data.get('nameEn', ''),
          200
        )
        && boundedString(
          request.resource.data.get('nameAr', ''),
          200
        )
        && boundedString(
          request.resource.data.get('firstName', ''),
          100
        )
        && boundedString(
          request.resource.data.get('middleName', ''),
          100
        )
        && boundedString(
          request.resource.data.get('lastName', ''),
          100
        )
        && boundedString(
          request.resource.data.get('contactName', ''),
          300
        )
        && boundedString(
          request.resource.data.get('village', ''),
          120
        )
        && boundedString(
          request.resource.data.get('governorate', ''),
          120
        )
        && boundedString(
          request.resource.data.get('craftType', ''),
          120
        )
        && boundedString(
          request.resource.data.get('craftCategory', ''),
          120
        )
        && boundedString(
          request.resource.data.get('story', ''),
          2000
        )
        && boundedString(
          request.resource.data.get('bio', ''),
          2000
        )
        && boundedString(
          request.resource.data.get('socialLink', ''),
          500
        )
        && boundedString(
          request.resource.data.get('submittedAt', ''),
          40
        )
        && boundedString(
          request.resource.data.get('createdAt', ''),
          40
        );
    }

    // ---------------------------------------------------------------------
    // CMS / configuration
    // ---------------------------------------------------------------------

    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    match /shipping_rules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_versions/{versionId} {
      allow read, write: if isAdmin();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin registry is never client-writable.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // User accounts and profiles
    // ---------------------------------------------------------------------

    function userEmailMatchesAuth() {
      return !('email' in request.resource.data)
        || (
          'email' in request.auth.token
          && request.resource.data.email == request.auth.token.email
        );
    }

    function userSelfEditableKeys() {
      return [
        'uid',
        'name',
        'firstName',
        'lastName',
        'email',
        'phone',
        'avatar',
        'defaultGovernorate',
        'defaultCity',
        'defaultAddress',
        'defaultBuilding',
        'defaultNotes',
        'updatedAt',
        'createdAt'
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if (
          isOwner(userId)
          && request.resource.data.get('uid', '') == userId
          && request.resource.data.keys().hasOnly(userSelfEditableKeys())
          && userEmailMatchesAuth()
          && !request.resource.data.keys().hasAny([
            'role',
            'sellerId',
            'isBanned',
            'ordersPlaced'
          ])
        )
        || isAdmin();

      allow update: if (
          isOwner(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(userSelfEditableKeys())
          && userEmailMatchesAuth()
          && !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny([
                 'role',
                 'sellerId',
                 'isBanned',
                 'ordersPlaced',
                 'uid'
               ])
        )
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Phone uniqueness index
    // ---------------------------------------------------------------------

    function phoneRegistryPayloadOk(phoneKey) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'phone',
          'formatted',
          'cleanDigits',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('cleanDigits', '') is string
        && request.resource.data.get('cleanDigits', '').size() == 8
        && boundedString(
          request.resource.data.get('phone', ''),
          32
        )
        && boundedString(
          request.resource.data.get('formatted', ''),
          32
        )
        && (
          phoneKey == 'phone_' +
            request.resource.data.get('cleanDigits', '')
          ||
          phoneKey == '961' +
            request.resource.data.get('cleanDigits', '')
        );
    }

    match /phone_registry/{phoneKey} {
      allow get: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('uid', '') == request.auth.uid
        );
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (
          isSignedIn()
          && phoneRegistryPayloadOk(phoneKey)
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('uid', '') == request.auth.uid
          && phoneRegistryPayloadOk(phoneKey)
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('uid', '') == request.auth.uid
        );
    }

    // ---------------------------------------------------------------------
    // Carts and wishlists
    // ---------------------------------------------------------------------

    function cartPayloadOk(userId) {
      return request.resource.data.keys().hasOnly(['userId', 'items', 'updatedAt'])
        && request.resource.data.get('userId', userId) == userId
        && (!('items' in request.resource.data) || (
          request.resource.data.items is list
          && request.resource.data.items.size() <= 50
        ))
        && (!('updatedAt' in request.resource.data) || boundedString(request.resource.data.updatedAt, 40));
    }

    function wishlistPayloadOk(userId) {
      return request.resource.data.keys().hasOnly(['userId', 'productIds', 'updatedAt'])
        && request.resource.data.get('userId', userId) == userId
        && (!('productIds' in request.resource.data) || (
          request.resource.data.productIds is list
          && request.resource.data.productIds.size() <= 200
        ))
        && (!('updatedAt' in request.resource.data) || boundedString(request.resource.data.updatedAt, 40));
    }

    match /carts/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && cartPayloadOk(userId)) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if (isOwner(userId) && wishlistPayloadOk(userId)) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------------------------------------------------------------------
    // ORDERS - authoritative Cloud Function only
    // ---------------------------------------------------------------------

    function sellerOrderPatchOk() {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ])
        && request.resource.data.status in [
          'pending',
          'confirmed',
          'crafting',
          'courier_assigned',
          'in_transit',
          'delivered',
          'cancelled',
          'returned'
        ];
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
        );

      // Customer checkout MUST go through the authoritative placeOrder Cloud Function.
      // Direct Firestore creation from ANY client identity (including admins) is strictly forbidden.
      allow create: if false;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Seller Order Fulfillment Documents
    // ---------------------------------------------------------------------

    function isValidStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'pending' && (newStatus == 'confirmed' || newStatus == 'cancelled'))
        || (oldStatus == 'confirmed' && (newStatus == 'crafting' || newStatus == 'cancelled'))
        || (oldStatus == 'crafting' && (newStatus == 'courier_assigned' || newStatus == 'cancelled'))
        || (oldStatus == 'courier_assigned' && (newStatus == 'in_transit' || newStatus == 'cancelled'))
        || (oldStatus == 'in_transit' && (newStatus == 'delivered' || newStatus == 'cancelled'))
        || (oldStatus == 'delivered' && newStatus == 'returned')
        || (oldStatus == newStatus);
    }

    function sellerFulfillmentPatchOk() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      let oldStatus = resource.data.get('status', 'pending');
      let newStatus = request.resource.data.get('status', 'pending');
      return diff.hasOnly(['status', 'updatedAt', 'fulfillmentNotes', 'sellerTrackingNumber'])
        && request.resource.data.get('orderId', '') == resource.data.get('orderId', '')
        && request.resource.data.get('sellerId', '') == resource.data.get('sellerId', '')
        && !diff.hasAny(['trackingNumber'])
        && isValidStatusTransition(oldStatus, newStatus);
    }

    match /order_fulfillment/{orderId}/sellers/{sellerId} {
      allow get, list: if isAdmin()
        || (
          isSeller()
          && getSellerId() == sellerId
        );

      allow create: if false;

      allow update: if isAdmin()
        || (
          isSeller()
          && getSellerId() == sellerId
          && sellerFulfillmentPatchOk()
        );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Order idempotency records - authoritative Cloud Function only
    // ---------------------------------------------------------------------

    match /order_idempotency/{idempotencyId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Product reviews
    // ---------------------------------------------------------------------

    function reviewOrderProvesPurchase(orderId, productId) {
      let order = get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;

      return order.get('userId', '') == request.auth.uid
        && 'productIds' in order
        && order.productIds is list
        && order.productIds.hasAny([productId]);
    }

    function reviewBodyOk() {
      return request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.rating == math.floor(
          request.resource.data.rating
        )
        && boundedString(
          request.resource.data.comment,
          2000
        )
        && boundedString(
          request.resource.data.get('userName', ''),
          120
        )
        && boundedString(
          request.resource.data.get('createdAt', ''),
          40
        )
        && boundedString(
          request.resource.data.get('date', ''),
          40
        );
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'userId',
          'userName',
          'productId',
          'orderId',
          'rating',
          'comment',
          'date',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('productId', '') is string
        && reviewId ==
           request.auth.uid + '_' +
           request.resource.data.get('productId', '')
        && reviewBodyOk()
        && request.resource.data.get('orderId', '') is string
        && reviewOrderProvesPurchase(
          request.resource.data.get('orderId', ''),
          request.resource.data.get('productId', '')
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'rating',
                 'comment',
                 'updatedAt'
               ])
          && reviewBodyOk()
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.get('userId', '') == request.auth.uid
        );
    }

    // ---------------------------------------------------------------------
    // Admin activity, audit logs and system config
    // ---------------------------------------------------------------------

    match /recent_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /inventory_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Search analytics
    // ---------------------------------------------------------------------

    match /search_logs/{logId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && 'userId' in request.resource.data
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id',
          'query',
          'timestamp',
          'userId',
          'userEmail',
          'userName',
          'origin',
          'resultsCount',
          'language',
          'filterCategory',
          'filterRegion',
          'createdAt'
        ])
        && request.resource.data.query is string
        && request.resource.data.query.size() > 0
        && request.resource.data.query.size() <= 200
        && (
          !('userEmail' in request.resource.data)
          || (
            'email' in request.auth.token
            && request.resource.data.userEmail == request.auth.token.email
          )
        )
        && (
          !('userName' in request.resource.data)
          || boundedString(request.resource.data.userName, 120)
        )
        && (
          !('timestamp' in request.resource.data)
          || boundedString(request.resource.data.timestamp, 40)
        )
        && (
          !('origin' in request.resource.data)
          || request.resource.data.origin in ['navbar', 'products_page', 'mobile_menu', 'direct']
        );

      allow update, delete: if isAdmin();
    }
  }
}