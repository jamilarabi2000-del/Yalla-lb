rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'jamilarabi2000@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSeller() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    function getSellerId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerId;
    }

    // Health / probe ping document used by connection testing
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public catalog & content
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || (isSeller()
        && request.resource.data.sellerId == getSellerId()
        && request.resource.data.priceUSD is number && request.resource.data.priceUSD >= 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 250);
      allow update: if isAdmin() || (isSeller()
        && resource.data.sellerId == getSellerId() && request.resource.data.sellerId == getSellerId()
        && request.resource.data.priceUSD is number && request.resource.data.priceUSD >= 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 250);
      allow delete: if isAdmin() || (isSeller() && resource.data.sellerId == getSellerId());
    }

    match /product_bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSeller() && sellerId == getSellerId() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive', 'active', 'sellerCode', 'id', 'accountEmail', 'accountUid', 'commissionPct', 'hasAccount']));
      allow delete: if isAdmin();
    }

    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry - read if admin, write disabled to prevent self-escalation
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User Accounts & Profiles: users cannot modify role, sellerId, or isBanned
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'sellerId', 'isBanned']));
      allow update: if isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'sellerId', 'isBanned']));
      allow delete: if isAdmin();
    }

    // Phone registry index for registration/lookup - prevents harvesting by restricting list to admin
    match /phone_registry/{phoneKey} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cleanDigits is string
        && request.resource.data.cleanDigits.size() == 8
        && (phoneKey == 'phone_' + request.resource.data.cleanDigits || phoneKey == '961' + request.resource.data.cleanDigits));
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cleanDigits is string
        && request.resource.data.cleanDigits.size() == 8
        && (phoneKey == 'phone_' + request.resource.data.cleanDigits || phoneKey == '961' + request.resource.data.cleanDigits));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Carts & Wishlists (owner or admin)
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders: only customer with verified email can create; sellers cannot delete or modify financial fields; list is restricted to user or seller
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || (isSeller() && resource.data.sellerIds.hasAny([getSellerId()]))));
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSeller() && resource.data.sellerIds.hasAny([getSellerId()]));
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.subtotalUSD is number && request.resource.data.subtotalUSD >= 0
        && request.resource.data.deliveryFeeUSD is number && request.resource.data.deliveryFeeUSD >= 0
        && request.resource.data.totalUSD is number && request.resource.data.totalUSD >= 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.shipping is map
        && request.resource.data.trackingNumber is string
        && request.resource.data.paymentMethod in ['cod_usd', 'cod_lbp', 'whish_pay', 'omt_pay'];
      allow update: if isAdmin() || (isSeller() && resource.data.sellerIds.hasAny([getSellerId()]) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'items', 'totalUSD', 'subtotalUSD', 'deliveryFeeUSD', 'currency', 'paymentMethod', 'appliedCoupon', 'date']));
      allow delete: if isAdmin();
    }

    // Product Reviews - read public, signed-in users can only post for themselves with valid rating
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productId is string
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'productId'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Admin Activity & Config
    match /recent_activity/{activityId} {
      allow read, write: if isAdmin();
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Search analytics logs
    match /search_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.query is string
        && request.resource.data.query.size() <= 200;
      allow update, delete: if isAdmin();
    }
  }
}
